@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center bg-light p-5 rounded">
    <h1 class="display-4">Sip Smart</h1>
    <p class="lead">Your personalized wine experience awaits.</p>
</div>

<div class="container mt-5">
    <!-- Introduction Section -->
    <section class="row align-items-center my-5">
        <div class="col-md-6">
            <h2 class="text-primary">Discover Your Perfect Wine</h2>
            <p>
                At Sip Smart, we believe every moment deserves the perfect wine. Our AI-powered pairing assistant is here to make every experience memorable.
                Whether you're celebrating, unwinding, or simply exploring, we’re here to guide you to your ideal match.
            </p>
        </div>
        <div class="col-md-6 text-center">
            <img src="~/images/WineIconBckGrndRmv.png" alt="Wine Collection" class="img-fluid rounded shadow">
        </div>
    </section>

    <!-- AI-Powered Wine Pairing -->
    <section class="row my-5 text-center">
        <div class="col">
            <h2 class="text-primary">AI-Powered Wine Pairing</h2>
            <p class="mb-4">Tell us how you're feeling, what you're planning, or what the weather’s like – and our expert system will suggest the perfect wine pairing.</p>
            <p class="mb-4">From robust reds to delicate whites, let our technology surprise and delight your palate.</p>
            <a href="/Home/suggestions" class="btn btn-primary btn-lg">Find My Wine Match</a>
        </div>
    </section>

    <!-- How It Works -->
    <section class="row my-5 text-center">
        <h2 class="text-primary mb-4">How It Works</h2>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">Step 1</h3>
                    <p class="card-text">Share your mood, plans, or what’s on the menu.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">Step 2</h3>
                    <p class="card-text">Receive a personalized wine recommendation.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">Step 3</h3>
                    <p class="card-text">Learn about the wine and find it near you.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Wines -->
    <section class="row my-5 text-center">
        <div class="col">
            <h2 class="text-primary mb-4">Featured Wines of the Month</h2>
            <div class="row mt-4">
                <div class="col-md-4">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h4 class="card-title">Chardonnay Reserve</h4>
                            <p class="card-text">A buttery and bold white, perfect for cozy nights.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h4 class="card-title">Pinot Noir Rosé</h4>
                            <p class="card-text">Bright and floral, ideal for a sunny afternoon.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h4 class="card-title">Cabernet Sauvignon</h4>
                            <p class="card-text">A rich red, perfect for hearty dinners.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
