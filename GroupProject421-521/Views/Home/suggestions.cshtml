@{
    ViewData["Title"] = "Suggestions";
}

<div class="container my-5">
    <h1 class="text-primary mb-4 text-center">@ViewData["Title"]</h1>

    
    <div class="container my-4">
        <textarea id="gptPrompt" class="form-control" rows="4"
                  placeholder="Enter your wine-related question or request..."></textarea>
        <button id="askGPT" class="btn btn-primary mt-3">Send</button>

        <div class="mt-4">
            <p id="timerDisplay" class="text-muted"></p>
            <p id="timeoutWarning" class="text-warning" style="display:none;"></p>
            <div id="gptResponse" class="mt-3"></div>
        </div>
    </div>
</div>

<script>
    let timer = null;          
    let elapsedSeconds = 0;   
    let timeoutWarningShown = false;  // Flag to track if the warning was displayed

    async function askGptHandler() {
        const prompt = document.getElementById('gptPrompt').value.trim();
        const timerDisplay = document.getElementById('timerDisplay');
        const responseDisplay = document.getElementById('gptResponse');
        const timeoutWarning = document.getElementById('timeoutWarning');
        const askButton = document.getElementById('askGPT');

        if (!prompt) {
            alert('Please enter a prompt before submitting.');
            return;
        }

        askButton.disabled = true;

        if (timer) {
            clearInterval(timer);
            timer = null;
        }
        elapsedSeconds = 0;
        timeoutWarningShown = false;
        timerDisplay.innerText = 'Waiting for response...';
        responseDisplay.innerText = '';
        timeoutWarning.style.display = 'none';

        timer = setInterval(() => {
            elapsedSeconds++;
            timerDisplay.innerText = `Waiting for response: ${elapsedSeconds} seconds`;

            if (elapsedSeconds === 10 && !timeoutWarningShown) {
                timeoutWarning.innerText = "This request is taking longer than expected. Please wait a little longer.";
                timeoutWarning.style.display = 'block';
                timeoutWarningShown = true;
            }
        }, 1000);

        try {
            const response = await fetch('/UserPrompts/AskGPT', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ prompt: prompt }),
            });

            clearInterval(timer);
            timer = null;
            askButton.disabled = false;
            timeoutWarning.style.display = 'none'; 

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const data = await response.json();
            if (data.success) {
                responseDisplay.innerHTML = `<p>${data.response}</p>`;
            } else {
                responseDisplay.innerHTML = `<p class="text-danger">Error: ${data.error}</p>`;
            }
        } catch (error) {
            if (timer) {
                clearInterval(timer);
                timer = null;
            }
            askButton.disabled = false;

            responseDisplay.innerHTML = `<p class="text-danger">An unexpected error occurred: ${error.message}</p>`;
        }
    }

    document.getElementById('askGPT').addEventListener('click', askGptHandler);
</script>
